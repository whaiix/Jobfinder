# PostgreSQL
DATABASE_URL=postgres://jobpilot:jobpilot@localhost:5432/jobpilot

# France Travail — créer une application sur francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre

# Ces URL peuvent être remplacées si France Travail fait évoluer son portail.
FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=%2Fpartenaire
FRANCE_TRAVAIL_API_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
